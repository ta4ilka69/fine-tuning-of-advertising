# Скопируйте в backend/.env и заполните значения.
# compose пробрасывает файл в контейнер бэкенда; .env в git не попадает.

# Какой клиент модели использовать (пока только openai).
AI_PROVIDER=openai

# Ключ OpenAI API. Без ключа сервис стартует, но генерация вернёт 503.
OPENAI_API_KEY=sk-...

# Базовый URL: позволяет уйти на OpenAI-совместимый шлюз.
OPENAI_BASE_URL=https://api.openai.com/v1

# Модель и глубина «размышлений» (reasoning_effort) задаются ОТДЕЛЬНО для
# генерации объявлений и для обработки фотографий.
# Набор значений зависит от модели (например, minimal, low, medium, high, none)
# и меняется с выходом новых моделей. Бэкенд значения не ограничивает: неверное
# отвергнет OpenAI ошибкой 400 с точным списком допустимых для этой модели.
# Если специфичной переменной нет, используется общий фолбэк OPENAI_MODEL /
# OPENAI_REASONING_EFFORT. Пустой effort — параметр не отправляется.
OPENAI_GENERATION_MODEL=gpt-5-mini
OPENAI_GENERATION_REASONING_EFFORT=low
OPENAI_PHOTO_MODEL=gpt-5-mini
OPENAI_PHOTO_REASONING_EFFORT=low

# Общий фолбэк, если специфичные переменные не заданы.
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low

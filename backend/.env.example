# Скопируйте в backend/.env и заполните значения.
# compose пробрасывает файл в контейнер бэкенда; .env в git не попадает.

# Какой клиент модели использовать (пока только openai).
AI_PROVIDER=openai

# Ключ OpenAI API. Без ключа сервис стартует, но генерация вернёт 503.
OPENAI_API_KEY=sk-...

# Модель и базовый URL. base-url позволяет уйти на OpenAI-совместимый шлюз.
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
